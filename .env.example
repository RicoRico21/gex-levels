# Required - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Telegram: message @BotFather -> /newbot -> paste the token here.
# Leave JARVIS_TELEGRAM_ALLOWED_IDS empty on first run; Jarvis will print the
# chat id of whoever messages it so you can lock the bot to just you.
TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_ALLOWED_IDS=

# Where Jarvis keeps its memory. Point this at your real Obsidian vault when
# you're ready (e.g. /Users/you/Documents/Obsidian/Brain).
JARVIS_VAULT_DIR=./vault
JARVIS_OUTBOX_DIR=./outbox

# Model + reasoning depth (low | medium | high | xhigh | max)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high

# --- Safety gates. Both OFF. Do not flip these until you have watched Jarvis
# --- work for a few weeks and you trust what it produces.
JARVIS_ALLOW_EMAIL_SEND=false
JARVIS_ALLOW_LIVE_TRADES=false

# Only needed if you ever set JARVIS_ALLOW_EMAIL_SEND=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
